rules_version = '2';

// Somente os administradores (login Google com e-mail verificado) acessam as
// denúncias diretamente. Denunciantes falam apenas com as Cloud Functions,
// que usam o Admin SDK e ignoram estas regras.
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['pedro.a.m.pimenta@gmail.com', 'luana@estrelanova.org.br']
        && request.auth.token.email_verified == true
        && request.auth.token.firebase.sign_in_provider == 'google.com';
    }

    match /denuncias/{protocolo} {
      allow read: if isAdmin();
      // O admin só altera status e metadados de triagem; o relato é imutável.
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'atualizadaEm', 'prioridade', 'aguardandoResposta']);

      match /mensagens/{mensagemId} {
        allow read: if isAdmin();
        allow create: if isAdmin()
          && request.resource.data.keys().hasOnly(['autor', 'texto', 'criadaEm'])
          && request.resource.data.autor == 'comite'
          && request.resource.data.texto is string
          && request.resource.data.texto.size() > 0
          && request.resource.data.texto.size() <= 5000
          && request.resource.data.criadaEm == request.time;
      }

      match /notas/{notaId} {
        allow read, create, delete: if isAdmin();
      }
    }

    // Destinatários dos avisos por e-mail, cadastrados pelos admins no painel.
    // "padrao": denúncias comuns; "diretoria": quando pode envolver a diretoria.
    match /config/notificacoes {
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['padrao', 'diretoria', 'atualizadaEm', 'atualizadaPor'])
        && request.resource.data.padrao is list
        && request.resource.data.padrao.size() <= 20
        && request.resource.data.diretoria is list
        && request.resource.data.diretoria.size() <= 20
        && request.resource.data.atualizadaEm == request.time
        && request.resource.data.atualizadaPor == request.auth.token.email;
    }

    // Hash de senhas e controle de tentativas: nunca acessível por clientes.
    match /segredos/{protocolo} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
